<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the NSIS installer built from the signed app. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="OpenStage-${version}-win-x64.exe" product-name="OpenStage" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
