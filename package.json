{
  "name": "openstage",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @openstage/desktop dev",
    "build": "pnpm --filter @openstage/desktop build",
    "start": "pnpm --filter @openstage/desktop start",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
